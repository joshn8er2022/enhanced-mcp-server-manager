# MCP Server Manager Environment Configuration

# Logging Configuration
LOG_LEVEL=INFO
LOG_FORMAT=%(asctime)s - %(name)s - %(levelname)s - %(message)s
LOG_FILE=mcp_manager.log

# Server Configuration
DEFAULT_TIMEOUT=30
MAX_RETRIES=3
CONNECTION_POOL_SIZE=10

# Tool Execution
TOOL_TIMEOUT=60
MAX_CONCURRENT_TOOLS=5

# Security
ALLOWED_COMMANDS=filesystem,git,sqlite,time,memory,fetch
RESTRICTED_PATHS=/etc,/root,/sys,/proc
ENABLE_SHELL_COMMANDS=false

# Performance
CACHE_ENABLED=true
CACHE_TTL=300
BATCH_SIZE=10

# Development
DEBUG_MODE=false
ENABLE_METRICS=true
METRICS_PORT=8080